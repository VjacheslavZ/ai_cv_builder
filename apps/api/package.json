{
  "name": "@cv/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "pnpm build && concurrently -k -n tsc,api,worker \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\" \"node --watch dist/worker.js\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@cv/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "~5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@standard-schema/spec": "^1.1.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "pg": "^8.23.1",
    "prisma": "~7.10.0",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0"
  }
}
