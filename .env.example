# Required: the only value you must set before `docker compose up`.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max: depth of the model's thinking (cost vs quality).
ANTHROPIC_EFFORT=medium

# Optional locally (docker compose and `pnpm dev` fall back to a local-only default);
# required in production. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The URL users open (better-auth baseURL, the only trusted Origin; cookies are Secure unless localhost).
WEB_ORIGIN=http://localhost:3000

# Used only when running apps on the host (`pnpm infra:up` + `pnpm dev`).
# docker compose sets its own in-network URLs.
DATABASE_URL=postgresql://cv:cv@localhost:5432/cv
REDIS_URL=redis://localhost:6379
# Host ports published by `pnpm infra:up`; change them (and the URLs above) if taken.
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
# RedisInsight (Redis GUI) host port, used by `docker compose up` and `pnpm infra:up`.
REDISINSIGHT_PORT=5540

